<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. Without this capability the authorization sheet
	     fails at runtime with error 1000, and the entitlement must also be
	     enabled on the App ID in the Apple Developer portal. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal Links for the emailed confirmation/recovery links, verified
	     against https://www.pokepedia.id/.well-known/apple-app-site-association.
	     Like the Apple Sign-In entitlement above, Associated Domains must also
	     be enabled on the App ID in the Apple Developer portal, or the links
	     silently open in Safari instead. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.pokepedia.id</string>
		<string>applinks:pokepedia.id</string>
	</array>
</dict>
</plist>
