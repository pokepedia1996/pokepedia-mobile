<?xml version="1.0" encoding="utf-8"?>
<!-- Files the app hands straight to Instagram / WhatsApp. Only the
     social_share/ folder inside the cache (path_provider's temporary
     directory), where the share images are written - not the whole cache,
     which also holds scanner dumps and CSV exports. -->
<paths>
    <cache-path name="share_cache" path="social_share/"/>
</paths>
